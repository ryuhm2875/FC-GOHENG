rules_version = '2';
// 고흥FC 드림 프로젝트 보안 규칙
// Firebase 콘솔 → Firestore Database → 규칙 탭에 이 파일 내용을 통째로 붙여 넣고 '게시'를 누르세요.
// 관리자 이메일을 바꾸면 아래 isAdmin() 안의 이메일도 같이 바꿔야 합니다 (js/net/fb.js 의 ADMIN_EMAIL 과 같게).
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'ryubongdoo@gmail.com';
    }
    // 학생 본인인지: 로그인한 계정의 이메일이 '학번.열쇠@fc.goheung' 이고, 차단되지 않았을 때
    function isMe(sid) {
      let lg = get(/databases/$(database)/documents/fcg_login/$(sid)).data;
      return request.auth != null
        && request.auth.token.email == sid + '.' + lg.key + '@fc.goheung'
        && lg.get('blocked', false) != true;
    }

    // 학생 직접 가입: 관리자 페이지에서 가입을 막지 않았고, 새로 만든 계정의 이메일이 '학번.열쇠@fc.goheung'과 맞을 때만
    function signupOpen() {
      let cfg = /databases/$(database)/documents/fcg_config/main;
      return !exists(cfg) || get(cfg).data.get('signup', true) == true;
    }
    function selfSignup(sid) {
      return request.auth != null && signupOpen()
        && sid.matches('^[0-9A-Za-z-]{1,20}$')
        && request.resource.data.keys().hasOnly(['key', 'blocked'])
        && request.resource.data.blocked == false
        && request.auth.token.email == sid + '.' + request.resource.data.key + '@fc.goheung';
    }

    // 게임 스위치 (열림·닫힘, 시간 제한, 가입): 누구나 읽고, 관리자만 바꿈
    match /fcg_config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // 학번 목록 (로그인할 때 확인): 누구나 읽음. 새 학번은 관리자나 직접 가입하는 학생 본인이, 바꾸기·지우기는 관리자만
    match /fcg_login/{sid} {
      allow read: if true;
      allow create: if isAdmin() || selfSignup(sid);
      allow update, delete: if isAdmin();
    }
    // 학생 기록: 본인과 관리자만 읽음. 학생은 기록 칸(play, now, lastSeen)만 바꿀 수 있음
    match /fcg_students/{sid} {
      allow read: if isAdmin() || isMe(sid);
      allow create: if isAdmin()
        || (isMe(sid) && request.resource.data.keys().hasOnly(['name', 'created', 'self'])
            && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 20);
      allow delete: if isAdmin();
      allow update: if isAdmin()
        || (isMe(sid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['play', 'now', 'lastSeen']));
    }
    // 클라우드 저장: 본인과 관리자만
    match /fcg_saves/{sid} {
      allow read, write: if isAdmin() || isMe(sid);
    }
  }
}
